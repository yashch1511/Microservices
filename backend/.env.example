# Shared
JWT_SECRET=replace-with-a-strong-32-plus-char-secret
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092

# User service
USER_SERVICE_PORT=8081
USER_DB_URL=jdbc:mysql://localhost:3306/user_db
USER_DB_USERNAME=root
USER_DB_PASSWORD=change_me

# Notification service
NOTIFICATION_SERVICE_PORT=8082

# Product service
PRODUCT_SERVICE_PORT=8083
PRODUCT_DB_URL=jdbc:mysql://localhost:3306/product_db
PRODUCT_DB_USERNAME=root
PRODUCT_DB_PASSWORD=change_me

# Order service
ORDER_SERVICE_PORT=8085
ORDER_DB_URL=jdbc:mysql://localhost:3306/order_db
ORDER_DB_USERNAME=root
ORDER_DB_PASSWORD=change_me

# Payment service
PAYMENT_SERVICE_PORT=8086
PAYMENT_DB_URL=jdbc:mysql://localhost:3306/payment_db
PAYMENT_DB_USERNAME=root
PAYMENT_DB_PASSWORD=change_me
